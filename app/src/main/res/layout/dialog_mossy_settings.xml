<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#3D2314"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📜 MENU / DIFICULTAD"
        android:textColor="#FFD700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Velocidad y Bonificación de Monedas:"
        android:textColor="#FFF8DC"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_diff_lento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🐢 Lento (Coins x1.0)"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <Button
        android:id="@+id/btn_diff_medio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ Medio (Coins x1.5)"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <Button
        android:id="@+id/btn_diff_rapido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔥 Rápido (Coins x2.5)"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fondo del Juego:"
        android:textColor="#FFF8DC"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_bg_1"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content"
            android:text="🌌 Estelar"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btn_bg_2"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content"
            android:text="🌀 Vórtice"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btn_bg_3"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content"
            android:text="🪄 Varita"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:layout_margin="2dp"/>

        <Button
            android:id="@+id/btn_bg_4"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content"
            android:text="🔮 Galáctico"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:layout_margin="2dp"/>

    </GridLayout>

    <Button
        android:id="@+id/btn_close_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACEPTAR"
        android:textColor="#000000"
        android:backgroundTint="#FFD700"/>

</LinearLayout>
